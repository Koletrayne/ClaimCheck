# Copy to .env and fill in your values.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000

# Comma-separated list of allowed extension origins (optional).
# Leave blank to allow all origins during development.
ALLOWED_ORIGINS=

# ── Classroom Mode (optional) ────────────────────────────────────────
# Classroom Mode stays disabled and completely invisible until these are set;
# the public ClaimCheck experience is unaffected either way.
#
# Same project as the website/extension use. The service role key bypasses Row
# Level Security, so it must ONLY ever live here on the server — never in
# public/, never in the extension, never in a client bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# Key used to hash client IPs for classroom access-code rate limiting, so raw
# IP addresses are never stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLASSROOM_IP_HASH_SECRET=
