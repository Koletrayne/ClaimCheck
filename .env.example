# Copy to .env and fill in your values.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000

# Comma-separated list of allowed extension origins (optional).
# Leave blank to allow all origins during development.
ALLOWED_ORIGINS=

# ── Classroom Mode (optional) ────────────────────────────────────────
# Classroom Mode stays disabled and completely invisible until these are set;
# the public ClaimCheck experience is unaffected either way.
#
# Same project as the website/extension use. The service role key bypasses Row
# Level Security, so it must ONLY ever live here on the server — never in
# public/, never in the extension, never in a client bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# Key used to hash client IPs for classroom access-code rate limiting, so raw
# IP addresses are never stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLASSROOM_IP_HASH_SECRET=

# ── Usage guardrails ─────────────────────────────────────────────────
# Every limit below is optional; the value shown is the built-in default that
# applies when the variable is unset. Set a limit to 0 to turn that layer off.
#
# Longest claim the claim box accepts. Article-URL analysis is unaffected —
# extracted page text has its own, much larger cap.
CLAIMCHECK_MAX_CLAIM_CHARACTERS=750

# ClaimChecks one anonymous student may run in one classroom session. This is
# the "ClaimChecks per student" default a teacher sees on the create form: the
# shape of a single lesson, and a number a teacher can say out loud.
#
# ACCEPTED RANGE 1-20, the same range the API enforces on a teacher's own input.
# 0 is NOT accepted: it used to mean "no per-student gate", and multiplying a
# roster by it produced a classroom with no gate either. A value outside the
# range warns and falls back to 4.
CLAIMCHECK_STUDENT_SESSION_LIMIT=4

# ClaimChecks a whole classroom may run, across every student. Used only when a
# classroom recorded neither its own limit nor an expected class size.
# Minimum 1 -- there is no value here that means "unlimited".
CLAIMCHECK_CLASSROOM_SESSION_LIMIT=100

# Class size assumed when a teacher leaves the field blank. Chosen to agree with
# the two above: 25 x 4 = 100. Keep them agreeing, or a teacher who leaves the
# form blank is shown one capacity and given another.
CLAIMCHECK_DEFAULT_EXPECTED_STUDENTS=25

# A classroom's allowance is
#   expected_students x ClaimChecks-per-student x (this percent / 100)
# e.g. 25 students x 4 ClaimChecks x 1.00 = 100 -- the recommended shape for a
# normal classroom session, and what a blank create form produces.
#
# 100 (no headroom) is the default because the create form prints that
# arithmetic to the teacher, and a promise of "100 ClaimChecks" that resolved to
# 110 would be a number the system does not mean. Raise it if a class should be
# allowed to overspend its own arithmetic — a class rarely divides work evenly,
# and headroom stops the heaviest users hitting the class limit while quieter
# students still have unused allowance.
CLAIMCHECK_CLASSROOM_HEADROOM_PERCENT=100

# ── Token safety ceiling ─────────────────────────────────────────────
# Tokens are NOT a classroom's allowance; ClaimChecks are. These size an
# internal ceiling that exists to stop pathological consumption, and are set
# from measured behaviour rather than an estimate.
#
# Measured 2026-08-27 against the live pipeline: one ClaimCheck costs
# 26,556-50,240 tokens (median ~29,000). Almost all of it is input, because the
# web_search tool resolves server-side and every page it reads is billed on the
# one request that asked for it — so cost tracks the number of searches far more
# than the length of the claim.
#
# WHY 90,000 rather than something nearer the measurements:
#   - it must clear the worst case comfortably. Academic mode already costs 1.7x
#     the median at 3 searches, and the pipeline permits 5, so a legitimate
#     analysis can plausibly reach ~80,000 without anything being wrong;
#   - it must not be reachable by an ordinary class. A classroom has to average
#     roughly 3x the median across its whole allowance before this fires;
#   - it must still stop a runaway. A classroom burning 600,000 tokens per
#     analysis trips it within a handful of requests.
#
#   token_safety_limit = max(CLAIMCHECK_MIN_TOKEN_SAFETY_LIMIT,
#                            ClaimCheck allowance x this value)
#
# ACCEPTED RANGE 60,000-5,000,000. There is no value that removes the ceiling:
# 0 used to, and that was a way to make every classroom unmetered from a single
# environment variable. Anything invalid or out of range warns and falls back to
# 90,000 -- a typo must never silently switch a cost guardrail off.
CLAIMCHECK_TOKEN_SAFETY_PER_ANALYSIS=90000

# Floor for the whole-classroom ceiling, so a deliberately tiny classroom (a
# 3-ClaimCheck demo) is not tripped by one unusually expensive analysis landing
# early. Minimum 60,000, for the same reason: a ceiling a classroom could reach
# on its first request is a broken classroom, not a guardrail.
CLAIMCHECK_MIN_TOKEN_SAFETY_LIMIT=250000

# Per-API-call token logging: what each analysis cost, and what each classroom
# has spent per ClaimCheck. On by default outside production. Logs counts and a
# model name only — never claim text, results, or student ids.
CLAIMCHECK_TOKEN_DIAGNOSTICS=true

# Account-wide ceilings, counted in UTC. These are the last line of defence:
# when either is reached the backend refuses every analysis and no request is
# sent to any paid provider. They reset by the calendar key changing, so
# nothing needs to run on a schedule.
CLAIMCHECK_GLOBAL_DAILY_LIMIT=1000
CLAIMCHECK_GLOBAL_MONTHLY_LIMIT=15000

# LOCAL DEVELOPMENT ONLY. Escape hatch for a checkout with no Supabase
# credentials at all. When usage cannot be verified, ClaimCheck refuses the
# analysis rather than spending money blind; setting this to true restores
# permissive behaviour.
#
# It is IGNORED in production: NODE_ENV=production or VERCEL being set makes it
# inert whatever its value, and logs an error. It is also ignored whenever
# Supabase IS configured, so it can never override a merely-broken database.
#
# There is therefore no production configuration in which losing Supabase
# credentials turns metering off — production refuses instead.
CLAIMCHECK_ALLOW_UNVERIFIED_USAGE=false
